# =============================================================================
# DERMAINTEL — Unified .gitignore
# Covers: Python/ML backend, Node/React frontend, Jupyter, OS, IDE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MODEL ARTIFACTS (NEVER COMMIT — Large binaries >100MB)
# -----------------------------------------------------------------------------
*.keras
*.h5
*.hdf5
*.pkl
*.pickle
*.pth
*.pt
*.onnx
*.pb
*.tflite
*.weights
*.ckpt
*.ckpt.*

# SavedModel directories
saved_model/
checkpoints/

# -----------------------------------------------------------------------------
# 2. DATA FILES (Generated / Not source code)
# -----------------------------------------------------------------------------
*.csv
*.npy
*.npz
*.parquet
*.feather
*.sqlite
*.db

# Dataset folders
data/
datasets/
raw_data/
processed_data/

# Synthetic generator outputs
outputs/
plots/
figures/
results/

# Uploaded user images (if stored locally during dev)
uploads/
temp_uploads/
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp

# -----------------------------------------------------------------------------
# 3. PYTHON / FLASK / ML
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Flask
instance/
.webassets-cache

# Pytest / Coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/

# -----------------------------------------------------------------------------
# 4. JUPYTER NOTEBOOKS
# -----------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# 5. NODE / REACT / FRONTEND
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
web_modules/

# Build outputs
dist/
dist-ssr/
build/
.out/
.next/
.nuxt/
.output/
.vuepress/dist
.docusaurus/
.serverless/
.fusebox/
.dynamodb/

# Vite
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# TypeScript
*.tsbuildinfo

# -----------------------------------------------------------------------------
# 6. ENVIRONMENT & SECRETS (NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
.env.local
.env.development.local
.env.test.local
.env.production.local
.venv

# API Keys & secrets
secrets.json
credentials.json
service-account.json
*.pem
*.key

# -----------------------------------------------------------------------------
# 7. LOGS & TEMP FILES
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temp directories
tmp/
temp/
.tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 8. IDE & EDITOR FILES
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------------------------------------------------------------------
# 9. OS-SPECIFIC FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# 10. MISC
# -----------------------------------------------------------------------------
# Local Netlify folder
.netlify

# Vercel
.vercel

# Turborepo
.turbo

# Storybook
storybook-static/

# Docker
docker-compose.override.yml
# DERMAINTEL generated artifacts
dermaintel-api/artifacts/
dermaintel-ml/outputs/