# ---- Server ----
PORT=5001
NODE_ENV=development

# React/Vite dev server origin, for CORS
CLIENT_ORIGIN=http://localhost:5173

# ---- Flask ML API ----
FLASK_URL=http://127.0.0.1:5000
FLASK_PREDICT_PATH=/predict
FLASK_TIMEOUT_MS=30000

# ---- MongoDB (OPTIONAL) ----
# Leave this blank / unset and the app still runs fine — predictions just
# won't be saved to history. Fill it in whenever you're ready to persist.
MONGODB_URI=
